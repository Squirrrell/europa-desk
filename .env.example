# Optional. Without a key the server ranks stories with a keyword/coverage heuristic.
OPENAI_API_KEY=
# Any chat model that supports JSON schema output.
OPENAI_MODEL=gpt-5-mini

# How often the scraper + ranking pipeline runs.
REFRESH_MINUTES=30
# Port of the API server in `npm run dev` (Vite proxies /api to it). `npm start` uses PORT, then 8787.
API_PORT=8787
